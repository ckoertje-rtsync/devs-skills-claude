@SuppressWarnings("unused")
public class {{class_name}} extends Coupled {
    private static final long serialVersionUID = 1L;

    // ─── External ports ───────────────────────────────────────────────────
    {{#each external_input_ports}}
    public final Port {{name}} = addInputPort("{{name}}"{{#if type}}, {{type}}.class{{/if}});
    {{/each}}
    {{#each external_output_ports}}
    public final Port {{name}} = addOutputPort("{{name}}"{{#if type}}, {{type}}.class{{/if}});
    {{/each}}

    // ─── Constructors ────────────────────────────────────────────────────
    public {{class_name}}() {
        this("{{class_name}}");
    }

    public {{class_name}}(String name) {
        super(name);

        // ─── Children (already-defined component models) ──────────────────
        {{#each children}}
        {{class_name}} {{var_name}} = new {{class_name}}({{constructor_args_csv}});
        {{#if is_coupled}}addCoupledChildModel({{var_name}});{{else}}addChildModel({{var_name}});{{/if}}
        {{/each}}

        {{#if uses_port_style}}
        // ─── External Input Couplings (EIC): this.in -> child.in ──────────
        {{#each eic_couplings}}
        addCoupling(this.{{from_port}}, {{to_child}}.{{to_port}});
        {{/each}}

        // ─── Internal Couplings (IC): child.out -> child.in ───────────────
        {{#each ic_couplings}}
        addCoupling({{from_child}}.{{from_port}}, {{to_child}}.{{to_port}});
        {{/each}}

        // ─── External Output Couplings (EOC): child.out -> this.out ───────
        {{#each eoc_couplings}}
        addCoupling({{from_child}}.{{from_port}}, this.{{to_port}});
        {{/each}}
        {{else}}
        // ─── External Input Couplings (EIC) ──────────────────────────────
        {{#each eic_couplings}}
        addExternalInputCoupling("{{from_port}}", "{{to_child_name}}", "{{to_port}}");
        {{/each}}

        // ─── Internal Couplings (IC) ─────────────────────────────────────
        {{#each ic_couplings}}
        addInternalCoupling("{{from_child_name}}", "{{from_port}}", "{{to_child_name}}", "{{to_port}}");
        {{/each}}

        // ─── External Output Couplings (EOC) ─────────────────────────────
        {{#each eoc_couplings}}
        addExternalOutputCoupling("{{from_child_name}}", "{{from_port}}", "{{to_port}}");
        {{/each}}
        {{/if}}
    }
{{#if generate_main}}

    public static void main(String[] args) {
        {{class_name}} top = new {{class_name}}();
        CoupledCoordinator coord = new CoupledCoordinator(top);
