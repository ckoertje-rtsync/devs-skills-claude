\section {{slug}}_diagram Coupling diagram

\dot
digraph {{slug}}_couplings {
    rankdir=LR;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    subgraph cluster_{{slug}} {
        label="{{name}}";
        style=rounded;
{{#each components}}        {{id}} [shape=box, label="{{name}} : {{model}}"];
{{/each}}    }
{{#each input_ports}}    in_{{id}} [shape=plaintext, label="{{name}}"];
{{/each}}{{#each output_ports}}    out_{{id}} [shape=plaintext, label="{{name}}"];
{{/each}}{{#each eic}}    in_{{coupled_port_id}} -> {{component_id}} [label="{{coupled_port}} -> {{component_port}}"];
{{/each}}{{#each ic}}    {{from_id}} -> {{to_id}} [label="{{from_port}} -> {{to_port}}"];
{{/each}}{{#each eoc}}    {{component_id}} -> out_{{coupled_port_id}} [label="{{component_port}} -> {{coupled_port}}"];
{{/each}}}
\enddot

