# Doxyfile for {{PROJECT_NAME}} — generated by the devs-doxygen skill.
#
# Regenerate the HTML from this directory with:
#     doxygen Doxyfile
# then open html/index.html.
#
# Only settings that differ from Doxygen's defaults are listed; every other tag
# takes the default of the installed Doxygen version (1.9 or newer recommended).

#--- Project -----------------------------------------------------------------
PROJECT_NAME           = "{{PROJECT_NAME}}"
PROJECT_BRIEF          = "{{PROJECT_BRIEF}}"
OUTPUT_DIRECTORY       = .
FULL_PATH_NAMES        = NO

#--- Input (paths are relative to this file's directory) ---------------------
INPUT                  = {{INPUT}}
FILE_PATTERNS          = {{FILE_PATTERNS}}
RECURSIVE              = {{RECURSIVE}}
EXCLUDE_PATTERNS       = */html/* */build/* */target/* */.git/* */node_modules/* */julia-doxygen-filter.py

#--- Language-specific settings ----------------------------------------------
{{LANGUAGE_SETTINGS}}

#--- Extraction --------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

#--- Output ------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
MARKDOWN_SUPPORT       = YES

#--- Diagrams: the \dot blocks in the .dox files need Graphviz ---------------
HAVE_DOT               = {{HAVE_DOT}}
DOT_IMAGE_FORMAT       = svg
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
DIRECTORY_GRAPH        = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO

#--- Warnings (read by resources/scripts/run-doxygen.sh) ---------------------
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = doxygen-warnings.log
