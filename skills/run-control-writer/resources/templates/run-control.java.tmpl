{{! run-control-writer template: one run control class = one experiment on one DEVS model family.
    Placeholders use {{double-braces}}. {{#if x}}...{{else}}...{{/if}} marks a choice, {{#each list}}...{{/each}}
    a repeated block. Fill every placeholder, keep one branch of each {{#if}}, delete the /* OPTIONAL */ blocks
    the experiment does not need, then delete this header. Field meanings: SKILL.md "Run Context". }}
{{#if package}}package {{package}};

{{/if}}import java.lang.reflect.InvocationTargetException;
import java.util.ArrayList;

import com.ms4systems.devs.analytics.InternalUseSeS;
{{#if ms4me}}import com.ms4systems.devs.core.model.impl.CoupledModelImpl;
{{else}}import com.ms4systems.devs.core.model.impl.Coupled;
{{/if}}import com.ms4systems.devs.core.util.SimulateModel;
import com.ms4systems.devs.core.util.fileHandler;
import com.ms4systems.devs.core.util.sesRelationExtend;

/**
 * {{class_name}} - run control for {{system_name}}.
 *
 * Experiment: {{experiment_purpose}}
 * Flavor: {{#if ms4me}}MS4 Me (CoupledModelImpl; execute() / executeWView()){{else}}Closure-DEVS jar (Coupled; execute(numIterations)){{/if}}
 *
 * Generated by the run-control-writer skill.
 */
public class {{class_name}} extends SimulateModel {

    // ---- 1. Experiment variables -------------------------------------------------
    // Static so main() can change them between runs. Every execute() call regenerates
    // the model, so defineModel() and setParams() see the current values each time.
    {{#each experiment_vars}}
    public static {{type}} {{name}}{{#if value}} = {{value}}{{/if}};{{#if comment}}   // {{comment}}{{/if}}
    {{/each}}

    // ---- Model family: SES and PES written beforehand (ses-designer) ---------------
    // Read from src/Models/ses/ and src/Models/pes/ under the working directory
    // (SimulateModel.folderses / folderpes). Selections and multi-aspects can only be
    // edited here if the SES already declares them.
    static String sesfile = "{{ses_file}}";
    static String pesfile = "{{pes_file}}";

    public {{class_name}}() {
        super();
    }

    // ---- 2. Define the model -------------------------------------------------------
    // Read the SES/PES, edit the pruning as text, prune to a coupled model.
    @Override
    public void defineModel() {
        String sesContents = fileHandler.getContentsAsString(folderses + sesfile);
        String pesContents = fileHandler.getContentsAsString(folderpes + pesfile);

        {{#each selections}}
        // Specialization {{spec}} of {{entity}}: {{current}} -> {{choice_expr}}
        pesContents = pesContents.replace("select {{current}} from {{spec}} for {{entity}}",
                                          "select " + {{choice_expr}} + " from {{spec}} for {{entity}}");
        {{/each}}
        {{#each multiplicities}}
        // Multi-aspect {{entity}}: [{{current}}] -> [{{count_expr}}]
        pesContents = pesContents.replace("[{{current}}] for {{entity}}",
                                          "[" + {{count_expr}} + "] for {{entity}}");
        {{/each}}

        /* OPTIONAL: pick one alternative of a specialization at random (SES-declared choices only).
        sesRelationExtend ses = InternalUseSeS.getSesFromFile(sesfile);
        String[] choices = getChoices(ses, "{{spec}}");
        String choice = selectFrom(choices);
        pesContents = pesContents.replace("select {{current}} from {{spec}}", "select " + choice + " from {{spec}}");
        */

        sesRelationExtend rses = InternalUseSeS.getSesFromContents(sesContents, pesContents);
        {{#if ms4me}}model = (CoupledModelImpl) InternalUseSeS.pruneNTransToGetModelInstanceWContents(rses, pesContents);
        {{else}}model = (Coupled) InternalUseSeS.pruneNTransToGetModelInstanceWContents(rses, pesContents);
        {{/if}}
    }

    // ---- 3. Set parameters ---------------------------------------------------------
    // Model names are the atomic names inside the pruned coupled model:
    //   plain entity            -> "Entity"
    //   chosen specialization   -> "Choice_Entity"      (for example "mode_RunningTransd")
    //   multi-aspect instances  -> setValuesForAll with the name part they share
    // setValue calls the public setter set<Var>(T) by reflection, so the setter must exist
    // and T must be exactly the class given (int.class, not Integer.class).
    @Override
    public void setParams() throws ClassNotFoundException, NoSuchMethodException, SecurityException,
            IllegalAccessException, IllegalArgumentException, InvocationTargetException {
        {{#each single_params}}
        setValue("{{model}}", "{{var}}", {{value_expr}}, {{type}}.class);
        {{/each}}
        {{#each group_params}}
        setValuesForAll("{{name_part}}", "{{var}}", {{value_expr}}, {{type}}.class);
        {{/each}}

        /* OPTIONAL: stop at a fixed simulation time instead of waiting for every model to passivate.
           Works when the SimulateModel in use creates `sim` before calling setParams() (MS4 Me);
           the Closure-DEVS jar ignores it and stops after execute(numIterations) iterations.
        setMaxSimulationTime({{max_sim_time}});
        */
    }

    // ---- 4. Get and analyze results -------------------------------------------------
    // getValue returns Object; cast to the getter's declared type. Append one CSV row per
    // observation. Anything beyond simple summaries is easier outside Java.
    @Override
    public void getAndAnalyzeResults() throws ClassNotFoundException, NoSuchMethodException, SecurityException,
            IllegalAccessException, IllegalArgumentException, InvocationTargetException {
        {{#each outputs}}
        {{type}} {{local}} = ({{type}}) getValue("{{model}}", "{{var}}");
        {{/each}}

        fileHandler.appendToFile(resultsFile, {{csv_row_expr}});
    }

    // ---- 5. Main: the experiment ------------------------------------------------------
    public static void main(String[] args) throws ClassNotFoundException, NoSuchMethodException, SecurityException,
            IllegalAccessException, IllegalArgumentException, InvocationTargetException {
        {{class_name}} sm = new {{class_name}}();
        sm.setResultsFile("{{results_file}}");                      // resolved under src/Models/txt/
        fileHandler.writeToFile(sm.resultsFile, "{{csv_header}}");  // clears old rows; appendToFile adds the rest

        final long startTime = System.currentTimeMillis();         // wall time sizes an outer loop's delay

        {{#if sweep}}
        for (int i = {{sweep.from}}; i < {{sweep.to}}; i++) {
            {{sweep.var}} = i;
            {{#if ms4me}}sm.execute();{{else}}sm.execute({{num_iterations}});{{/if}}
        }
        {{else}}
        {{#if ms4me}}sm.execute();{{else}}sm.execute({{num_iterations}});{{/if}}
        {{/if}}

        /* OPTIONAL (MS4 Me only): one run with the SimViewer open to watch the message flow. Slow.
        sm.executeWView();
        */

        final long endTime = System.currentTimeMillis();
        System.out.println("Experiment wall time: " + (endTime - startTime) / 1000 + " s");
    }
}
