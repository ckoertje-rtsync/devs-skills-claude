package {{PACKAGE}};

import java.util.Arrays;
import java.util.HashMap;
{{EXTRA_IMPORTS}}

/**
 * Paratemporal tree node for the {{DOMAIN}} model with quantized-evidence state.
 *
 * <p>Evidence is represented as an integer level {@code evidenceLevel ∈ [0, G-1]}
 * combined across the path via the driver's homomorphic lookup table
 * {@code T[i][j]}. Optional {@code histogram[k]} counts occurrences of level
 * {@code k} for symmetry-merging equivalence.
 *
 * <p>References:
 *   - resources/patterns/quantized-evidence-integration.md
 *   - resources/reference/quantized-helpers-cheatsheet.md
 *   - docs/paradevs/EvidenceAppendix.pdf §§A, C, E, F
 */
public class {{NODE_CLASS}} {

    // ------------------------------------------------------------------ //
    //  Tree bookkeeping
    // ------------------------------------------------------------------ //

    /** Branch label → child node. */
    public final HashMap<String, {{NODE_CLASS}}> children = new HashMap<>();
    public String  name;
    public int     level;
    /** Single-branch probability {@code Pr(branch | parent)}. */
    public double  prob = 1.0;
    /** Cumulative probability from the root; {@code parent.pathProb * prob}. */
    public double  pathProb = 1.0;
    /** Terminal outcome — do not expand further. */
    public boolean terminated;

    // ------------------------------------------------------------------ //
    //  Quantized-evidence state
    // ------------------------------------------------------------------ //

    /** Graininess (cached from the driver's compile-time G). */
    public int G;

    /** Accumulated evidence level in {@code {0,…,G-1}}. */
    public int evidenceLevel;

    /** Optional histogram of level occurrences along the path. Non-null when
     *  histogram equivalence is used; null when scalar equivalence is used. */
    public int[] histogram;

    // ------------------------------------------------------------------ //
    //  Domain state (non-evidence fields, if any)
    // ------------------------------------------------------------------ //

{{STATE_FIELDS}}

    // ------------------------------------------------------------------ //
    //  Construction
    // ------------------------------------------------------------------ //

    public {{NODE_CLASS}}(String nm, int G) {
        name = nm;
        this.G = G;
        this.evidenceLevel = 0;
{{HISTOGRAM_INIT}}
{{STATE_INIT}}
    }

    // ------------------------------------------------------------------ //
    //  Branching
    // ------------------------------------------------------------------ //

    /**
     * Create a child node by applying one new quantized evidence input.
     *
     * @param label       branch label
     * @param evidenceIn  new evidence level in {@code {0,…,G-1}} — caller
     *                    quantizes raw values with the driver's {@code quantize(x, G)}
     * @param T           the driver's precomputed {@code G×G} operator table
     * @param prob        single-branch probability
     * @return the new child node
     */
    public {{NODE_CLASS}} setBranchEvidence(String label, int evidenceIn,
                                            int[][] T, double prob) {
        {{NODE_CLASS}} n = new {{NODE_CLASS}}(name + ":" + label, this.G);
        children.put(label, n);
        n.level = level + 1;
        n.prob = prob;
        n.pathProb = pathProb * prob;

        // Combine via the homomorphic lookup (constant-time integer op).
        n.evidenceLevel = T[this.evidenceLevel][evidenceIn];

        // Update histogram if enabled.
        if (this.histogram != null) {
            n.histogram = this.histogram.clone();
            n.histogram[evidenceIn] += 1;
        }

{{STATE_COPY_AND_DELTA}}

        return n;
    }

    // ------------------------------------------------------------------ //
    //  Object overrides
    // ------------------------------------------------------------------ //

    @Override
    public String toString() {
        return "{{NODE_CLASS}}{"
                + "name=" + name
                + ", level=" + level
                + ", evidenceLevel=" + evidenceLevel
                + ", pathProb=" + String.format("%.6f", pathProb)
                + (histogram != null ? ", histogram=" + Arrays.toString(histogram) : "")
{{TOSTRING_STATE_FIELDS}}
                + "}";
    }
}
