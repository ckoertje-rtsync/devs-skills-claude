package {{PACKAGE}};

import java.util.HashMap;
import java.util.HashSet;
import java.util.function.DoubleBinaryOperator;
{{EXTRA_IMPORTS}}

/**
 * Paratemporal tree driver for the {{DOMAIN}} model with quantized-evidence
 * accumulation and threshold classification at the terminals.
 *
 * <p>An instance of this class is the tree container (root + frontier sets);
 * the static methods build and query it. The quantization helpers
 * ({@link #quantize}, {@link #representative}, {@link #buildTable},
 * {@link #labelFor}) are self-contained — no external library.
 *
 * <p>Pattern references:
 *   - resources/patterns/quantized-evidence-integration.md
 *   - resources/patterns/make-tree-to-depth.md
 *   - resources/patterns/advance-leaf-front.md
 *   - resources/patterns/equivalence-merging.md
 *   - docs/paradevs/EvidenceAppendix.pdf §§A–F
 */
public class {{DRIVER_CLASS}} {

    // ------------------------------------------------------------------ //
    //  Compile-time configuration
    // ------------------------------------------------------------------ //

    /** Graininess — tune per deployment (embedded: 5-10; simulation: 100+). */
    public static final int G = {{G_VALUE}};

    /** Continuous combining operator {@code U : [0,1]² → [0,1]}. {{OPERATOR_COMMENT}} */
    public static final DoubleBinaryOperator U = (v1, v2) -> {{OPERATOR_LAMBDA}};

    /** Precomputed homomorphic operator table {@code T[i][j] = Q_G(U(r_G(i), r_G(j)))}. */
    public static final int[][] T = buildTable(G, U);

    /** Thresholds in the G-domain. Sorted ascending. */
    public static final int[] THRESHOLDS = {{THRESHOLDS_ARRAY}};

    /** Action labels; length = THRESHOLDS.length + 1; labels[0] is the default. */
    public static final String[] ACTION_LABELS = {{ACTION_LABELS_ARRAY}};

    static {
        checkClassifier(THRESHOLDS, ACTION_LABELS);
    }

    /** When true, equivalent children are merged into a single node. */
    public static boolean useEquivalence = true;

    /** When true, nodes maintain a histogram of path-level counts. */
    public static boolean useHistogram = {{USE_HISTOGRAM}};

    /** Default expansion depth. */
    public static int defaultDepth = {{DEFAULT_DEPTH}};

    // ------------------------------------------------------------------ //
    //  Tree container
    // ------------------------------------------------------------------ //

    public {{NODE_CLASS}} root;
    /** Current BFS frontier; replaced on every {@code advanceLeafFront}. */
    public HashSet<{{NODE_CLASS}}> leaves    = new HashSet<>();
    /** Nodes that have been expanded. */
    public HashSet<{{NODE_CLASS}}> interiors = new HashSet<>();
    /** Outcome nodes that will not be expanded further. */
    public HashSet<{{NODE_CLASS}}> terminals = new HashSet<>();

    // ------------------------------------------------------------------ //
    //  Quantization helpers (EvidenceAppendix.pdf §§A, F.5)
    // ------------------------------------------------------------------ //

    /** {@code Q_G(x) = min(G-1, floor(G*x))}, with {@code x} clamped to {@code [0,1]}. */
    public static int quantize(double x, int G) {
        if (x <= 0.0) return 0;
        if (x >= 1.0) return G - 1;
        return Math.min(G - 1, (int) Math.floor(G * x));
    }

    /**
     * Bin-center representative {@code r_G(k) = (k + 0.5) / G}. Not the same
     * as the linear {@code k / (G-1)} used when porting thresholds across G.
     */
    public static double representative(int k, int G) {
        return (k + 0.5) / G;
    }

    /** Homomorphic operator table {@code T[i][j] = Q_G(U(r_G(i), r_G(j)))}. */
    public static int[][] buildTable(int G, DoubleBinaryOperator U) {
        int[][] t = new int[G][G];
        for (int i = 0; i < G; i++) {
            for (int j = 0; j < G; j++) {
                t[i][j] = quantize(U.applyAsDouble(representative(i, G), representative(j, G)), G);
            }
        }
        return t;
    }

    /** Highest-exceeded-threshold rule; {@code ACTION_LABELS[0]} when none is exceeded. */
    public static String labelFor(int k) {
        for (int i = THRESHOLDS.length - 1; i >= 0; i--) {
            if (THRESHOLDS[i] <= k) return ACTION_LABELS[i + 1];
        }
        return ACTION_LABELS[0];
    }

    /** Fails class load on a label/threshold length mismatch or unsorted thresholds. */
    static void checkClassifier(int[] thresholds, String[] labels) {
        if (labels.length != thresholds.length + 1) {
            throw new IllegalStateException("ACTION_LABELS.length must be THRESHOLDS.length + 1");
        }
        for (int i = 1; i < thresholds.length; i++) {
            if (thresholds[i] <= thresholds[i - 1]) {
                throw new IllegalStateException("THRESHOLDS must be strictly ascending at i=" + i);
            }
        }
    }

    // ------------------------------------------------------------------ //
    //  makeTreeToDepth
    // ------------------------------------------------------------------ //

    public static {{DRIVER_CLASS}} makeTreeToDepth(int maxDepth) {
        {{DRIVER_CLASS}} bt = new {{DRIVER_CLASS}}();
        {{NODE_CLASS}} root = new {{NODE_CLASS}}("root", G);
        root.level = 0;
        root.pathProb = 1.0;
        if (useHistogram) root.histogram = new int[G];
{{ROOT_INIT}}
        bt.root = root;
        bt.leaves.add(root);

        for (int d = 0; d < maxDepth; d++) {
            advanceLeafFront(bt, d);
        }
        return bt;
    }

    // ------------------------------------------------------------------ //
    //  advanceLeafFront
    // ------------------------------------------------------------------ //

    /**
     * Expand every current leaf on one layer by enumerating all quantized
     * evidence levels with the per-layer probability distribution.
     *
     * <p>The input probability distribution defaults to uniform over all G
     * levels; replace {@link #evidenceProbs(int)} with domain-specific
     * distributions when appropriate.
     */
    public static void advanceLeafFront({{DRIVER_CLASS}} bt, int layer) {
        HashSet<{{NODE_CLASS}}> newLeaves = new HashSet<>();
        double[] probs = evidenceProbs(layer);

        for ({{NODE_CLASS}} n : bt.leaves) {
            bt.interiors.add(n);

            for (int levelIn = 0; levelIn < G; levelIn++) {
                double p = probs[levelIn];
                if (p <= 0.0) continue;
                {{NODE_CLASS}} child = n.setBranchEvidence(
                        Integer.toString(levelIn), levelIn, T, p);

                if (useEquivalence) {
                    {{NODE_CLASS}} equiv = equivalentTo(child, newLeaves);
                    if (equiv == null) {
                        newLeaves.add(child);
                    } else {
                        equiv.pathProb = equiv.pathProb + child.pathProb;
                    }
                } else {
                    newLeaves.add(child);
                }
            }
        }
        bt.leaves = newLeaves;
    }

    /**
     * Probability distribution over the G quantized levels for a given layer.
     * Default: uniform. Override per domain.
     */
    public static double[] evidenceProbs(int layer) {
        double[] p = new double[G];
        double u = 1.0 / G;
        for (int k = 0; k < G; k++) p[k] = u;
        return p;
    }

    // ------------------------------------------------------------------ //
    //  Equivalence
    // ------------------------------------------------------------------ //

    public static {{NODE_CLASS}} equivalentTo({{NODE_CLASS}} leaf,
                                              HashSet<{{NODE_CLASS}}> nodes) {
        for ({{NODE_CLASS}} n : nodes) {
            if (equivalent(n, leaf)) return n;
        }
        return null;
    }

{{EQUIVALENT_METHOD}}

    // ------------------------------------------------------------------ //
    //  Aggregation — classify terminals and build a PMF over action labels
    // ------------------------------------------------------------------ //

    /**
     * Sum {@code pathProb} across every leaf grouped by the action label
     * returned by {@link #labelFor(int)}.
     */
    public static HashMap<String, Double> actionPMF({{DRIVER_CLASS}} bt) {
        HashMap<String, Double> pmf = new HashMap<>();
        for (String lbl : ACTION_LABELS) pmf.put(lbl, 0.0);
        for ({{NODE_CLASS}} n : bt.leaves) {
            String action = labelFor(n.evidenceLevel);
            pmf.merge(action, n.pathProb, Double::sum);
        }
        return pmf;
    }

    // ------------------------------------------------------------------ //
    //  main harness
    // ------------------------------------------------------------------ //

    public static void main(String[] args) {
        int depth = (args.length > 0) ? Integer.parseInt(args[0]) : defaultDepth;

        long start = System.currentTimeMillis();
        {{DRIVER_CLASS}} bt = makeTreeToDepth(depth);
        long end = System.currentTimeMillis();

        HashMap<String, Double> pmf = actionPMF(bt);
        System.out.println("{{DRIVER_CLASS}}: depth=" + depth
                + " G=" + G
                + " leaves=" + bt.leaves.size()
                + " elapsedMs=" + (end - start));
        for (String lbl : ACTION_LABELS) {
            System.out.printf("  %s = %.6f%n", lbl, pmf.get(lbl));
        }
    }
}
