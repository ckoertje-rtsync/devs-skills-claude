package {{PACKAGE}};

import java.util.HashMap;
{{EXTRA_IMPORTS}}

/**
 * Paratemporal tree node for the {{DOMAIN}} model.
 *
 * <p>Each node carries the domain-specific state that persists along a branch
 * from root to this node. setBranch*() methods snapshot parent state and
 * mutate the field(s) that change on this branch.
 *
 * <p>Pattern references:
 *   - resources/patterns/set-branch-state-snapshot.md
 *   - resources/reference/paradevs-api-cheatsheet.md (node bookkeeping fields)
 */
public class {{NODE_CLASS}} {

    // ------------------------------------------------------------------ //
    //  Tree bookkeeping
    // ------------------------------------------------------------------ //

    /** Branch label → child node. */
    public final HashMap<String, {{NODE_CLASS}}> children = new HashMap<>();
    public String  name;
    public int     level;
    /** Single-branch probability {@code Pr(branch | parent)}. */
    public double  prob = 1.0;
    /** Cumulative probability from the root; {@code parent.pathProb * prob}. */
    public double  pathProb = 1.0;
    /** Terminal outcome — do not expand further. */
    public boolean terminated;

    // ------------------------------------------------------------------ //
    //  Domain state
    // ------------------------------------------------------------------ //

{{STATE_FIELDS}}

    // ------------------------------------------------------------------ //
    //  Construction
    // ------------------------------------------------------------------ //

    public {{NODE_CLASS}}(String nm) {
        name = nm;
{{STATE_INIT}}
    }

    // ------------------------------------------------------------------ //
    //  Branching
    // ------------------------------------------------------------------ //

    /**
     * Creates a child node for branch {{BRANCH_DESCRIPTION}}.
     *
     * <p>Snapshots parent state, applies the branch delta, and installs the
     * child in the {@code children} map.
     *
     * @param label branch label (becomes suffix on the child's name and key in {@code children})
{{SETBRANCH_PARAM_DOCS}}
     * @param prob  single-branch probability; {@code pathProb = parent.pathProb * prob}
     * @return the newly created child node
     */
    public {{NODE_CLASS}} {{SETBRANCH_NAME}}(String label{{SETBRANCH_PARAMS}}, double prob) {
        {{NODE_CLASS}} n = new {{NODE_CLASS}}(name + label);
        children.put(label, n);
        n.level = level + 1;
        n.prob = prob;
        n.pathProb = pathProb * prob;
{{STATE_COPY_AND_DELTA}}
        return n;
    }

    // ------------------------------------------------------------------ //
    //  Object overrides
    // ------------------------------------------------------------------ //

    @Override
    public String toString() {
        return "{{NODE_CLASS}}{"
                + "name=" + name
                + ", level=" + level
                + ", pathProb=" + String.format("%.6f", pathProb)
{{TOSTRING_STATE_FIELDS}}
                + "}";
    }
}
